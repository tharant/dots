#!/usr/bin/env bash
# Pre-commit hook: run shellcheck on staged bash files
# Install: git config core.hooksPath .githooks

set -euo pipefail

if ! command -v shellcheck &>/dev/null; then
  echo "pre-commit: shellcheck not found, skipping (install with: brew install shellcheck)"
  exit 0
fi

# Collect staged bash files (scripts + dotfiles).
# Portable loop instead of mapfile (bash 3.2 on macOS has no mapfile; it would
# silently leave `files` empty).
# Vendored third-party code (vim plugins, trueline) is shipped verbatim — skip it.
files=()
while IFS= read -r -d '' f; do
  case "$f" in
    common/vim/.vim/bundle/*) continue ;;
    common/trueline/*)        continue ;;
    *.sh)                     files+=("$f") ;;
    */.bashrc)                files+=("$f") ;;
    */.bash_profile)          files+=("$f") ;;
    */.bash_aliases)          files+=("$f") ;;
    */.bash_functions)        files+=("$f") ;;
    */.bash_sensible)         files+=("$f") ;;
    */.bash_linux)            files+=("$f") ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACM)

if [[ ${#files[@]} -eq 0 ]]; then
  exit 0
fi

echo "pre-commit: running shellcheck on ${#files[@]} file(s)..."

failed=0
for f in "${files[@]}"; do
  if ! shellcheck -s bash -e SC1090,SC1091 "$f"; then
    failed=1
  fi
done

if [[ $failed -ne 0 ]]; then
  echo ""
  echo "pre-commit: shellcheck found issues. Fix them before committing."
  echo "To bypass: git commit --no-verify"
  exit 1
fi

echo "pre-commit: shellcheck passed."
