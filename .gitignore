# Plaintext secrets — never commit these
# (id_* matches key files at any name, e.g. id_ecdsa_qemu; keep *.pub out)
id_rsa
id_ed25519
id_ecdsa
id_dsa
id_*
!id_*.pub
*.pem
*.key
*.secret
.env
.env.*
!.env.example

# direnv/runtimes runtime artifacts (locks + venvs minted by evaluation)
.runtimes.lock
.venv/

# age identity (private key)
keys.txt

# Worktrees
.worktrees/

# IDE
.idea/

# OS junk
.DS_Store
Thumbs.db

# Editor state/backups
.viminfo
.netrwhist
*~
# vim theme choice is per-machine (written at runtime through the stow symlink)
common/vim/.vim/.theme
tags
doc/tags
.claude/
