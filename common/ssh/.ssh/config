# ~/.ssh/config — Shared SSH client config

# OrbStack 'orb' host (must precede any Host block; silently ignored if absent)
Include ~/.orbstack/ssh/config

# macOS-only option; ignored gracefully by non-Apple OpenSSH builds via IgnoreUnknown
IgnoreUnknown UseKeychain
UseKeychain yes

Host *
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3

# QEMU/VM test machines — key deployed by secrets pipeline (secrets/ssh/id_ecdsa_qemu.age)
Host qemu qemu.* 192.168.121.* 10.0.2.*
    IdentityFile ~/.ssh/id_ecdsa_qemu
    IdentitiesOnly yes