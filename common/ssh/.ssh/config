# ~/.ssh/config — Shared SSH client config

# OrbStack 'orb' host (must precede any Host block; silently ignored if absent)
Include ~/.orbstack/ssh/config

# macOS-only option; ignored gracefully by non-Apple OpenSSH builds via IgnoreUnknown
IgnoreUnknown UseKeychain
UseKeychain yes

Host *
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3

# xrq.io — key deployed by secrets pipeline (secrets/ssh/xrq.io-ecdsa.age);
# non-default key name, so ssh only offers it when a matching Host block exists
Host xrq.io *.xrq.io
    IdentityFile ~/.ssh/xrq.io-ecdsa
    IdentitiesOnly yes