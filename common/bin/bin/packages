#!/usr/bin/env bash
set -euo pipefail

# Package wishlist manager — the CLI half of the ~/.packages integration (the
# file itself is seeded from templates/packages/.packages by dots-setup).
# Reads a per-machine wishlist (one entry per line, '#' comments allowed),
# resolves each entry against whatever backends are actually installed — apt,
# apk, dnf, pacman, pkg (BSD), brew (the only one on a pristine Mac) — and
# installs what is missing. Bare names are tried by exact match in backend
# priority order; @mgr:alt,alt2 pins override the name on that backend and
# @mgr:- excludes it entirely. An entry matching nowhere is resolved once
# interactively from search candidates; the decision is cached in
# ~/.local/state/packages/resolutions so a machine only ever asks twice —
# once per name. Names kept in the wishlist purely to record what dots-setup
# guarantees (bash, git, direnv ...) are "provided" and skipped silently.
# Deliberately no pruning: dropping a line from the wishlist stops managing
# that package, it never uninstalls. stdout is human output; prompts read
# stdin, falling back to /dev/tty. Portable: bash 3.2 (indexed arrays only,
# no mapfile, no case-folding); BusyBox userland.

DOTS_DIR="${DOTS_DIR:-$HOME/.dots}"
PACKAGES_FILE="${PACKAGES_FILE:-$HOME/.packages}"
STATE_DIR="${PACKAGES_STATE_DIR:-$HOME/.local/state/packages}"
CACHE_FILE="$STATE_DIR/resolutions"
SEARCH_MAX=5          # candidates offered per backend at the prompt
CAND_TOTAL_MAX=10     # candidates offered in total

# Names provisioned by dots-setup (scripts/setup.sh install_core /
# install_runtimes) plus their platform spellings. Kept in the wishlist as the
# auditable record of what the bootstrap guarantees; never package-resolved.
PROVIDED="age bash bc coreutils curl direnv fnm git just jq locales less \
sdkman shellcheck stow tmux uv xz-utils"

# --- Globals (bash-3.2-safe: array expansion guarded on counts under set -u) -
BE_LIST=""        # ordered, space-separated available backends
BE_MATCH=""       # package name matched by be_has()
PRIV=""           # privilege prefix: "" | sudo | doas

ENTRY_NAME=""
PIN_N=0
PIN_MGRS=""
PIN_ALTS=""
EXCL=""

R_MGR="" R_PKG="" R_STATE=""   # resolve_one() result per entry
CAND_N=0
CAND_MGR=()
CAND_PKG=()

COUNT_TOTAL=0 COUNT_PROVIDED=0 COUNT_INSTALLED=0
COUNT_RESOLVED=0 COUNT_UNRESOLVED=0 COUNT_FAILED=0

info() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m==> WARNING:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m==> ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
    cat >&2 <<'EOF'
Usage: packages <command> [args]

Maintain the ~/.packages wishlist: the machine's running record of what
packages it has. dots-setup seeds a minimal baseline; grow it by hand
(`echo htop >> ~/.packages`) and converge the system with `packages update`.

Commands:
  update            Satisfy every entry in ~/.packages: refresh backend
                    indexes, skip what is installed or provided by setup,
                    resolve and install the rest.
  status            Report each wishlist entry's state (provided / installed
                    / resolved / no match / unresolved). Read-only: no
                    installs, no prompts.
  add <name> [@mgr:pkg ...]
                    Append an entry to ~/.packages and install it. A misspelt
                    duplicate is reported, not re-added.
  init [template]   Seed ~/.packages from a template file (default: the repo
                    checkout beside the installed shim). Refuses to overwrite
                    an existing wishlist.
  -h | --help       Show this help.

Entry syntax (in ~/.packages and in `add`):
  name                exact name on every backend, priority order
  name @apt:a,b       on apt try a, then b (other backends still try name)
  name @brew:-        never resolve this entry on brew
  # ...               comments and blank lines are ignored

Backends, in resolution order: apt, apk, dnf, pacman, pkg, brew (brew alone
on macOS). The first backend with the exact name (or a pin) wins; the choice
is recorded in ~/.local/state/packages/resolutions and reused.

Exit codes: 0 success; 1 usage error; 2 completed with one or more entries
unresolved or failed installs.
EOF
    exit "${1:-2}"
}

# --- Messaging / privilege helpers -------------------------------------------

read_line() {
    # read_line <prompt> — prompt on stderr, read one line into REPLY_VAL.
    # Reads stdin (tty or pipe); on EOF falls back to /dev/tty so an update
    # run under `curl | bash` can still prompt.
    local reply=""
    printf '%s' "$1" >&2
    if IFS= read -r reply; then
        REPLY_VAL="$reply"
        return 0
    fi
    if [ -e /dev/tty ] && { : </dev/tty; } 2>/dev/null; then
        if IFS= read -r reply </dev/tty; then
            REPLY_VAL="$reply"
            return 0
        fi
    fi
    return 1
}

trim() {
    # trim <string> — outer whitespace
    printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

detect_priv() {
    if [ "$(id -u)" -eq 0 ]; then
        PRIV=""
    elif command -v sudo >/dev/null 2>&1; then
        PRIV="sudo"
    elif command -v doas >/dev/null 2>&1; then
        PRIV="doas"
    else
        PRIV=""
        warn "neither root, sudo nor doas available — system package installs will fail"
    fi
}

run_priv() {
    # run_priv <cmd...> — same as "$PRIV $@" when not already root (brew is
    # never called through this: it must run as the user)
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    else
        "$PRIV" "$@"
    fi
}

# --- Wishlist entry parsing ---------------------------------------------------

pin_get() {
    # pin_get <mgr> — print the pinned alt list (comma-separated) or nothing
    local i=0 mgr alts
    [ "$PIN_N" -eq 0 ] && return 0
    while [ "$i" -lt "$PIN_N" ]; do
        mgr="${PIN_MGRS[$i]}"; alts="${PIN_ALTS[$i]}"
        [ "$mgr" = "$1" ] && { printf '%s' "$alts"; return 0; }
        i=$((i + 1))
    done
    return 0
}

pin_is_excluded() {
    case " $EXCL " in *" $1 "*) return 0 ;; esac
    return 1
}

entry_parse() {
    # entry_parse <tokens...> — first non-pin token is the entry name; @mgr
    # tokens are pins. Sets ENTRY_NAME / PIN_* / EXCL. Returns 1 for a
    # comment-only line (caller skips it).
    ENTRY_NAME=""
    PIN_N=0
    PIN_MGRS=()
    PIN_ALTS=()
    EXCL=""
    local t mgr alts rest
    for t in "$@"; do
        case "$t" in
            @*)
                rest="${t#@}"
                case "$rest" in
                    *:*)
                        mgr="${rest%%:*}"
                        alts="${rest#*:}"
                        if [ "$alts" = "-" ]; then
                            EXCL="$EXCL $mgr"
                        else
                            PIN_MGRS+=("$mgr")
                            PIN_ALTS+=("$alts")
                            PIN_N=$((PIN_N + 1))
                        fi
                        ;;
                    *) die "bad pin '$t' — expected @mgr:pkg or @mgr:-" ;;
                esac
                ;;
            *)
                if [ -z "$ENTRY_NAME" ]; then
                    ENTRY_NAME="$t"
                else
                    die "entry has two names: '$ENTRY_NAME' and '$t'"
                fi
                ;;
        esac
    done
    [ -n "$ENTRY_NAME" ]
}

entry_pins_summary() {
    # entry_pins_summary — human form of the pins, e.g. "@apt:build-essential !brew"
    local summary="" i=0 mgr
    [ "$PIN_N" -eq 0 ] || {
        while [ "$i" -lt "$PIN_N" ]; do
            summary="$summary @${PIN_MGRS[$i]}:${PIN_ALTS[$i]}"
            i=$((i + 1))
        done
    }
    for mgr in $EXCL; do
        summary="$summary !$mgr"
    done
    printf '%s' "$summary"
}

# --- Provided baseline ---------------------------------------------------------

is_provided() {
    case " $PROVIDED " in *" $1 "*) return 0 ;; esac
    return 1
}

# --- Backends -------------------------------------------------------------------

detect_backends() {
    # Ordered by resolution priority; macOS is brew-only. Linux/BSD consult
    # Homebrew as a fallback after the system package manager (Linuxbrew).
    BE_LIST=""
    local b
    case "$(uname -s)" in
        Darwin)
            BE_LIST="brew"
            ;;
        *)
            for b in apt-get apk dnf pacman pkg brew; do
                command -v "$b" >/dev/null 2>&1 || continue
                [ "$b" = "apt-get" ] && b="apt"
                BE_LIST="$BE_LIST $b"
            done
            ;;
    esac
    BE_LIST="${BE_LIST# }"
}
# One function per operation, dispatched on $1 = backend key.
#   be_has <mgr> <name>...          repo lookup; BE_MATCH = first found name
#   be_installed <mgr> <pkg>        installed on this machine?
#   be_install <mgr> <pkg>          install (root ops go through run_priv)
#   be_refresh <mgr>                refresh the backend's index caches
#   be_search <mgr> <term>          print candidate package names (plain)

be_has() {
    local mgr="$1" p
    shift
    BE_MATCH=""
    case "$mgr" in
        apt)
            for p in "$@"; do
                if apt-cache show "$p" >/dev/null 2>&1; then
                    BE_MATCH="$p"
                    return 0
                fi
            done
            ;;
        apk)
            for p in "$@"; do
                if [ -n "$(apk search -q -x "$p" 2>/dev/null)" ]; then
                    BE_MATCH="$p"
                    return 0
                fi
            done
            ;;
        dnf)
            for p in "$@"; do
                if dnf -q --cacheonly list available "$p" >/dev/null 2>&1; then
                    BE_MATCH="$p"
                    return 0
                fi
            done
            ;;
        pacman)
            for p in "$@"; do
                if pacman -Si "$p" >/dev/null 2>&1; then
                    BE_MATCH="$p"
                    return 0
                fi
            done
            ;;
        pkg)
            for p in "$@"; do
                if [ -n "$(pkg search -q "^$p\$" 2>/dev/null)" ]; then
                    BE_MATCH="$p"
                    return 0
                fi
            done
            ;;
        brew)
            for p in "$@"; do
                if [ -n "$(brew search --formula "^$p$" 2>/dev/null)" ] ||
                   [ -n "$(brew search --cask "^$p$" 2>/dev/null)" ]; then
                    BE_MATCH="$p"
                    return 0
                fi
            done
            ;;
    esac
    return 1
}

be_installed() {
    local mgr="$1" pkg="$2"
    case "$mgr" in
        apt)    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'ok installed' ;;
        apk)    apk info -e "$pkg" >/dev/null 2>&1 ;;
        dnf)    rpm -q "$pkg" >/dev/null 2>&1 ;;
        pacman) pacman -Qi "$pkg" >/dev/null 2>&1 ;;
        pkg)    pkg info -e "$pkg" >/dev/null 2>&1 ;;
        brew)   brew list --formula "$pkg" >/dev/null 2>&1 ||
                brew list --cask "$pkg" >/dev/null 2>&1 ;;
        *)      return 1 ;;
    esac
}

be_install() {
    local mgr="$1" pkg="$2"
    case "$mgr" in
        apt)    run_priv apt-get install -y "$pkg" ;;
        apk)    run_priv apk add "$pkg" ;;
        dnf)    run_priv dnf install -y "$pkg" ;;
        pacman) run_priv pacman -S --needed --noconfirm "$pkg" ;;
        pkg)    run_priv pkg install -y "$pkg" ;;
        brew)
            if [ "$(id -u)" -eq 0 ]; then
                warn "brew refuses to run as root — cannot install $pkg"
                return 1
            fi
            brew install "$pkg"
            ;;
        *) return 1 ;;
    esac
}

be_refresh() {
    # apt and apk fail their lookups outright on a stale/empty index (the
    # "package not found" misresolution trap), so they refresh by default;
    # dnf/pacman/pkg/brew refresh or fall back on their own.
    case "$1" in
        apt)    run_priv apt-get update ;;
        apk)    run_priv apk update ;;
        pacman) run_priv pacman -Sy ;;
        *)      return 0 ;;
    esac
}

be_search() {
    # be_search <mgr> <term> — candidate names to stdout, plain, one per line
    local mgr="$1" term="$2"
    case "$mgr" in
        apt)
            apt-cache search --names-only "^$term" 2>/dev/null | awk '{print $1}' |
                head -n "$SEARCH_MAX"
            ;;
        apk)
            apk search -q "$term" 2>/dev/null | sed 's/-[^-]*-r[0-9][^ ]*$//' |
                head -n "$SEARCH_MAX"
            ;;
        dnf)
            dnf -q list available "$term*" 2>/dev/null |
                awk '$1 ~ /\./ && $1 !~ /^(Last|Available)/ {sub(/\.[^.]*$/, "", $1); print $1}' |
                head -n "$SEARCH_MAX"
            ;;
        pacman)
            pacman -Ss "^$term" 2>/dev/null |
                awk '/^[^ ]+\/[^ ]+ / {n=$1; sub(/^[^\/]*\//, "", n); print n}' |
                head -n "$SEARCH_MAX"
            ;;
        pkg)
            pkg search -q "^$term" 2>/dev/null | head -n "$SEARCH_MAX"
            ;;
        brew)
            brew search "$term" 2>/dev/null |
                sed -e 's/^[[:space:]]*//' -e 's/ (cask)$//' -e 's/^==>.*$//' |
                grep -v '^$' | head -n "$SEARCH_MAX"
            ;;
    esac
}

# --- Resolution cache ------------------------------------------------------------

cache_get() {
    # cache_get <name> — sets R_CACHE_MGR / R_CACHE_PKG; backend "-" = skip
    [ -f "$CACHE_FILE" ] || return 1
    local line n m p tab
    tab="$(printf '\t')"
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        n="${line%%"$tab"*}"
        [ "$n" = "$1" ] || continue
        rest="${line#*"$tab"}"
        m="${rest%%"$tab"*}"
        p="${line##*"$tab"}"
        R_CACHE_MGR="$m"
        R_CACHE_PKG="$p"
        return 0
    done < "$CACHE_FILE"
    return 1
}

cache_put() {
    # cache_put <name> <mgr> <pkg> — replace any prior line for <name>
    local tmp name="$1" mgr="$2" pkg="$3" tab
    tab="$(printf '\t')"
    mkdir -p "$STATE_DIR"
    tmp="$CACHE_FILE.tmp.$$"
    if [ -f "$CACHE_FILE" ]; then
        grep -vF "${name}${tab}" "$CACHE_FILE" > "$tmp" || true
    else
        : > "$tmp"
    fi
    printf '%s\t%s\t%s\n' "$name" "$mgr" "$pkg" >> "$tmp"
    mv "$tmp" "$CACHE_FILE"
}

# --- Per-entry resolution ---------------------------------------------------------

candidate_search() {
    # Collect search candidates across all non-excluded backends into CAND_*
    CAND_N=0
    CAND_MGR=()
    CAND_PKG=()
    local b c
    for b in $BE_LIST; do
        pin_is_excluded "$b" && continue
        while IFS= read -r c; do
            [ -n "$c" ] || continue
            CAND_MGR+=("$b")
            CAND_PKG+=("$c")
            CAND_N=$((CAND_N + 1))
            [ "$CAND_N" -ge "$CAND_TOTAL_MAX" ] && return 0
        done < <(be_search "$b" "$ENTRY_NAME" 2>/dev/null)
    done
    return 0
}

candidate_prompt() {
    # Interactive resolution for an entry that matched nothing exactly.
    # Sets R_MGR/R_PKG and returns 0 when a choice was made and installed.
    local i b c choice
    candidate_search "$ENTRY_NAME"
    if [ "$CAND_N" -eq 0 ]; then
        warn "$ENTRY_NAME matched no backend exactly and no search turned up candidates"
        return 1
    fi
    warn "$ENTRY_NAME matched no backend exactly — candidates:"
    warn "$ENTRY_NAME matched no backend exactly — candidates:"
    i=0
    while [ "$i" -lt "$CAND_N" ]; do
        printf '    %d) %-6s %s\n' "$((i + 1))" "${CAND_MGR[$i]}" "${CAND_PKG[$i]}" >&2
        i=$((i + 1))
    done
    if ! read_line "choose a number to install, 's' to skip on this machine, [Enter] to leave unresolved: " ||
       [ -z "$REPLY_VAL" ]; then
        return 1
    fi
    choice="$REPLY_VAL"
    case "$choice" in
        s|S)
            info "recording permanent skip for $ENTRY_NAME ($CACHE_FILE)"
            cache_put "$ENTRY_NAME" "-" "-"
            return 1
            ;;
        *[!0-9]*|"")
            return 1
            ;;
        *)
            if [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "$CAND_N" ]; then
                R_MGR="${CAND_MGR[$((choice - 1))]}"
                R_PKG="${CAND_PKG[$((choice - 1))]}"
                cache_put "$ENTRY_NAME" "$R_MGR" "$R_PKG"
                return 0
            fi
            return 1
            ;;
    esac
}

has_usable_backend() {
    # True when at least one available backend is not pin-excluded
    local b
    for b in $BE_LIST; do
        pin_is_excluded "$b" || return 0
    done
    return 1
}

resolve_one() {
    # decide backend/pkg for ENTRY_NAME — no installs, no prompts.
    # Sets R_STATE (resolved | excluded | nomatch) and R_MGR/R_PKG when
    # resolved.
    R_STATE="nomatch"
    R_MGR=""
    R_PKG=""
    cache_get "$ENTRY_NAME" || { R_CACHE_MGR=""; R_CACHE_PKG=""; }
    if [ "$R_CACHE_MGR" = "-" ]; then
        R_STATE="excluded"
        return 0
    fi
    # 1. the recorded resolution, if that backend is still available and not
    #    excluded by a newer pin
    if [ -n "$R_CACHE_MGR" ] &&
       ! pin_is_excluded "$R_CACHE_MGR" &&
       be_has "$R_CACHE_MGR" "$R_CACHE_PKG"; then
        R_MGR="$R_CACHE_MGR"
        R_PKG="$R_CACHE_PKG"
        R_STATE="resolved"
        return 0
    fi
    # 2. fresh lookup: the backend's pinned alts first, then the bare name;
    #    the first backend holding one wins
    local b alts
    for b in $BE_LIST; do
        pin_is_excluded "$b" && continue
        alts="$(pin_get "$b")"
        # be_has takes multiple candidate names — deliberate word splitting
        # shellcheck disable=SC2086
        if be_has "$b" $alts "$ENTRY_NAME"; then
            R_MGR="$b"
            R_PKG="$BE_MATCH"
            R_STATE="resolved"
            return 0
        fi
    done
    return 1
}

installed_here() {
    # ENTRY_NAME already installed on any non-excluded backend? The recorded
    # resolution is checked first, so a pinned alt that is installed counts.
    local b alts p
    if [ -n "$R_CACHE_MGR" ] && [ "$R_CACHE_MGR" != "-" ] &&
       be_installed "$R_CACHE_MGR" "$R_CACHE_PKG"; then
        return 0
    fi
    for b in $BE_LIST; do
        pin_is_excluded "$b" && continue
        alts="$(pin_get "$b")"
        for p in $alts "$ENTRY_NAME"; do
            if be_installed "$b" "$p"; then
                return 0
            fi
        done
    done
    return 1
}

# --- One wishlist entry --------------------------------------------------------

plan_entry() {
    # plan_entry — report one entry's state (status: no installs, no prompts)
    local pins
    pins="$(entry_pins_summary)"
    if is_provided "$ENTRY_NAME"; then
        COUNT_PROVIDED=$((COUNT_PROVIDED + 1))
        printf '%-10s %s %s\n' "provided" "$ENTRY_NAME" \
            "— guaranteed by dots-setup; skipped"
        return 0
    fi
    resolve_one || true
    if installed_here; then
        COUNT_INSTALLED=$((COUNT_INSTALLED + 1))
        printf '%-10s %s\n' "installed" "$ENTRY_NAME"
        return 0
    fi
    case "$R_STATE" in
        resolved)
            COUNT_RESOLVED=$((COUNT_RESOLVED + 1))
            printf '%-10s %s -> %s/%s %s\n' "resolved" "$ENTRY_NAME" \
                "$R_MGR" "$R_PKG" "(run packages update to install)"
            ;;
        excluded)
            printf '%-10s %s %s\n' "skipped" "$ENTRY_NAME" \
                "(recorded skip — see $CACHE_FILE)"
            ;;
        nomatch)
            if ! has_usable_backend; then
                printf '%-10s %s %s\n' "not here" "$ENTRY_NAME" \
                    "(pins exclude every backend on this machine)"
                return 0
            fi
            COUNT_UNRESOLVED=$((COUNT_UNRESOLVED + 1))
            printf '%-10s %s %s\n' "no match" "$ENTRY_NAME" "$pins"
            ;;
    esac
    return 0
}

sync_entry() {
    # sync_entry — resolve and install one entry (update/add)
    if is_provided "$ENTRY_NAME"; then
        COUNT_PROVIDED=$((COUNT_PROVIDED + 1))
        return 0
    fi
    resolve_one || true
    if [ "$R_STATE" = "excluded" ] || ! has_usable_backend; then
        return 0    # recorded skip, or the pins exclude every backend here
    fi
    if installed_here; then
        COUNT_INSTALLED=$((COUNT_INSTALLED + 1))
        return 0
    fi
    if [ "$R_STATE" = "resolved" ]; then
        info "$ENTRY_NAME: installing $R_PKG ($R_MGR)"
        if be_install "$R_MGR" "$R_PKG"; then
            COUNT_RESOLVED=$((COUNT_RESOLVED + 1))
            return 0
        fi
        warn "$ENTRY_NAME: install failed — $R_PKG via $R_MGR"
        COUNT_FAILED=$((COUNT_FAILED + 1))
        return 1
    fi
    # No exact or recorded match: interactive resolution
    if candidate_prompt; then
        if be_install "$R_MGR" "$R_PKG"; then
            info "$ENTRY_NAME: installed $R_PKG ($R_MGR)"
            COUNT_RESOLVED=$((COUNT_RESOLVED + 1))
            return 0
        fi
        warn "$ENTRY_NAME: install of $R_PKG failed"
        COUNT_FAILED=$((COUNT_FAILED + 1))
        return 1
    fi
    warn "$ENTRY_NAME: unresolved — no exact match in any backend; skipped"
    COUNT_UNRESOLVED=$((COUNT_UNRESOLVED + 1))
    return 1
}

process_entry() {
    # process_entry <mode> <tokens...> — mode: status | update | add
    local mode="$1"
    shift
    entry_parse "$@" || return 0
    COUNT_TOTAL=$((COUNT_TOTAL + 1))
    case "$mode" in
        status) plan_entry ;;
        *)      sync_entry ;;
    esac
}

# --- Wishlist traversal ---------------------------------------------------------

iter_entries() {
    # iter_entries <mode> — run process_entry over ~/.packages; comments
    # (whole-line and trailing '#') and blank lines are skipped
    local mode="$1" line
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        line="$(trim "$line")"
        [ -n "$line" ] || continue
        # entry tokens are whitespace-split by design; an entry resolving to a
        # failure must not abort the whole run (set -e)
        # shellcheck disable=SC2086
        process_entry "$mode" $line || true
    done < "$PACKAGES_FILE"
}

wishlist_has() {
    # wishlist_has <name> — name already an entry (dedupe for `add`)
    local line t
    [ -f "$PACKAGES_FILE" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        line="$(trim "${line%%#*}")"
        [ -n "$line" ] || continue
        t="${line%%[[:space:]]*}"
        [ "$t" = "$1" ] && return 0
    done < "$PACKAGES_FILE"
    return 1
}

# --- Commands --------------------------------------------------------------------

refresh_backends() {
    local b
    detect_priv
    for b in $BE_LIST; do
        case "$b" in
            apt|apk|pacman)
                info "Refreshing the $b index..."
                be_refresh "$b" || warn "$b index refresh failed (offline?) — continuing"
                ;;
        esac
    done
}

summary() {
    if [ "$COUNT_PROVIDED" -gt 0 ]; then
        info "$COUNT_PROVIDED of $COUNT_TOTAL entries are provided by dots-setup — skipped silently"
    fi
    info "$COUNT_TOTAL entries: $COUNT_INSTALLED already installed, \
$COUNT_RESOLVED newly installed, $COUNT_FAILED failed install(s), \
$COUNT_UNRESOLVED unresolved"
}

cmd_update() {
    detect_backends
    [ -n "$BE_LIST" ] || die "no package manager backend found (apt, apk, dnf, pacman, pkg, brew)"
    [ -f "$PACKAGES_FILE" ] || die "no wishlist at $PACKAGES_FILE — run 'packages init' (or 'packages add <name>')"
    refresh_backends
    iter_entries update || true
    summary
    if [ "$COUNT_FAILED" -gt 0 ] || [ "$COUNT_UNRESOLVED" -gt 0 ]; then
        exit 2
    fi
}

cmd_status() {
    detect_backends
    [ -n "$BE_LIST" ] || die "no package manager backend found (apt/apk/dnf/pacman/pkg/brew)"
    [ -f "$PACKAGES_FILE" ] || die "no wishlist at $PACKAGES_FILE — run 'packages init' (or 'packages add <name>')"
    info "wishlist: $PACKAGES_FILE; backends:$BE_LIST"
    iter_entries status
    summary
}

cmd_add() {
    [ "$#" -ge 1 ] || usage 1
    case "$1" in
        -h|--help) usage 0 ;;
    esac
    detect_backends
    [ -n "$BE_LIST" ] || die "no package manager backend found (apt/apk/dnf/pacman/pkg/brew)"
    [ -f "$PACKAGES_FILE" ] || die "no wishlist at $PACKAGES_FILE — run 'packages init' first"
    if wishlist_has "$1"; then
        info "$1 is already in $PACKAGES_FILE — nothing added"
        return 0
    fi
    # Append after guaranteeing a trailing newline (the wishlist is
    # user-edited; a missing last newline would glue appends together)
    if [ -s "$PACKAGES_FILE" ] && [ -n "$(tail -c 1 "$PACKAGES_FILE")" ]; then
        printf '\n' >> "$PACKAGES_FILE"
    fi
    printf '%s\n' "$*" >> "$PACKAGES_FILE"
    info "added to $PACKAGES_FILE: $*"
    refresh_backends
    process_entry add "$@" || true
    summary
    if [ "$COUNT_FAILED" -gt 0 ] || [ "$COUNT_UNRESOLVED" -gt 0 ]; then
        exit 2
    fi
}

cmd_init() {
    local tmpl="${1:-}"
    if [ -z "$tmpl" ]; then
        # wishlist_template's failure is a normal "no template found" outcome
        # (set -e must not abort here) — the [ ! -f ] check below reports it
        tmpl="$(wishlist_template)" || tmpl=""
    fi
    if [ -e "$PACKAGES_FILE" ]; then
        die "$PACKAGES_FILE already exists — init never overwrites a wishlist"
    fi
    if [ ! -f "$tmpl" ]; then
        die "wishlist template not found at $tmpl — pass one explicitly: packages init <template>"
    fi
    cp "$tmpl" "$PACKAGES_FILE"
    info "Seeded $PACKAGES_FILE from $tmpl"
    info "Edit it freely; comments are skipped and 'packages update' converges."
}

repo_template() {
    # The template in the checkout this shim was deployed from: resolve $0's
    # symlink chain, then climb from common/bin/bin/<name> to the repo root
    local p="$0" t
    while [ -L "$p" ]; do
        t="$(readlink "$p")"
        case "$t" in
            /*) p="$t" ;;
            *)  p="$(dirname "$p")/$t" ;;
        esac
    done
    # three climbs from the shim's dir: bin → bin → common → repo root
    printf '%s\n' "$(cd "$(dirname "$p")/../../.." >/dev/null 2>&1 && pwd)/templates/packages/.packages"
}

wishlist_template() {
    local cand
    for cand in "$DOTS_DIR/templates/packages/.packages" "$(repo_template)"; do
        [ -f "$cand" ] && { printf '%s\n' "$cand"; return 0; }
    done
    return 1
}

main() {
    case "${1:-}" in
        -h|--help) usage 0 ;;
        "")        usage 2 ;;
        update)    shift; cmd_update ;;
        status)    cmd_status ;;
        add)       shift; cmd_add "$@" ;;
        init)      shift; cmd_init "$@" ;;
        *)         die "unknown command: $1 (see packages --help)" ;;
    esac
}

main "$@"