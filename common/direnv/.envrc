# shellcheck shell=bash
# ~/.envrc — tree-root environment (comment-only by design).
#
# direnv walks up from the current directory and evaluates the nearest
# .envrc it finds, so this file applies to every directory under $HOME
# that has no .envrc of its own. It exports nothing — a no-op everywhere.
#
# Project .envrc convention (children merge onto parents; the nearest
# .envrc wins for redefined vars, values a child does not mention persist
# from the parents):
#
#     source_up_if_exists     # evaluate the parent .envrc first
#     use_runtimes            # apply .runtimesrc via ~/.config/direnv/direnvrc
#     export FOO=bar          # project exports last, overriding parents
#
# Runtimes are pinned per project with lines like `python 3.12`, `node 22`,
# `java 17` in .runtimesrc (feature guide: docs/direnv-runtimes.md). After
# editing any .envrc, re-run `direnv allow` in its directory.