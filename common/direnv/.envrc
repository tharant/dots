# shellcheck shell=bash
# ~/.envrc — tree-root environment.
#
# direnv walks up from the current directory and evaluates the nearest
# .envrc it finds — and evaluates it from that file's own directory, so
# every directory under $HOME without an .envrc of its own gets this root,
# applied with PWD=$HOME. It applies the stowed LTS defaults in
# ~/.runtimesrc (python 3.12, node 24, java 25), resolved once into
# ~/.runtimes.lock by `runtimes ensure $HOME`; the defaults never mint a
# .venv (see use_python in ~/.config/direnv/direnvrc).
#
# A project that wants different runtimes ships its own .envrc — direnv
# evaluates the nearest .envrc only, so the root cannot see the standing
# directory. Ancestor chaining is the default (every .envrc above the
# nearest one is sourced, outermost first; a project .envrc is two lines,
# and `no_source_up` opts a directory out of the chain):
#
#     use_runtimes            # apply .runtimesrc via ~/.config/direnv/direnvrc
#     export FOO=bar          # project exports last, overriding ancestors
#
# Runtimes are pinned per project with lines like `python 3.12`, `node 24`,
# `java 25` in .runtimesrc (feature guide: docs/direnv-runtimes.md). After
# editing any .envrc — including this one — re-run `direnv allow` in its
# directory (`direnv allow $HOME` after a bless or restow).
use_runtimes "$HOME/.runtimesrc"    # the stowed LTS defaults