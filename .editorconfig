root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.sh]
indent_style = space
indent_size = 4

[.bash*]
indent_style = space
indent_size = 4

[common/bin/bin/*]
indent_style = space
indent_size = 4

[common/direnv/.envrc]
indent_style = space
indent_size = 4

[common/direnv/.config/direnv/*]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Justfile]
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
